ENV_FILE_TEMPLATE="""
# PECS Environment Configuration
# Copy this file to .env and fill in the values

# Ollama API endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Models
LLM_MODEL=phi4-mini
EMBEDDING_MODEL=nomic-embed-text

# LLM settings
LLM_TEMPERATURE=0.05

# Chunking parameters
MAX_CHUNK_CHARS=1500
MIN_CHUNK_CHARS=50
OVERLAP_CHARS=150
OVERLAP_MESSAGES=2

# Retrieval settings
RETRIEVAL_TOP_K=10
BM25_TOP_K=10

# Extraction settings
MAX_EXTRACTION_RETRIES=3
EXTRACTION_WORKERS=6  # Concurrent threads for LLM extraction; tune to your Ollama OLLAMA_NUM_PARALLEL

# Scoring weights
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3
CONFIDENCE_W_R=0.35
CONFIDENCE_W_M=0.30
CONFIDENCE_W_E=0.20
CONFIDENCE_W_D=0.15

# Storage paths
SQLITE_DB_PATH=data/sqlite/pecs.db
CHROMADB_PATH=data/chromadb/
LOG_FILE=data/logs/pecs.log

# Logging
LOG_LEVEL=INFO

# WhatsApp chunking
WHATSAPP_TIME_GAP_MINUTES=30

# File upload limits
MAX_FILE_SIZE_MB=50

# Neo4j graph database (local Community Edition — no auth required)
# Set NEO4J_ENABLED=false to disable all graph features without uninstalling Neo4j.
NEO4J_URI=neo4j://localhost:7687
NEO4J_DATABASE=neo4j
NEO4J_ENABLED=true
"""
