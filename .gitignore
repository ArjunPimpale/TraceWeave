# PECS — .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
!pecs/ui/components/trace_graph_frontend/dist/
!pecs/ui/components/trace_graph_frontend/dist/**
pecs/ui/components/trace_graph_frontend/node_modules/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables
.env
.env.*
!.env.example

# Data directories — never commit runtime data
/data/chromadb/
/data/sqlite/
/data/logs/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Streamlit local secrets
.streamlit/secrets.toml

# pytest
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/

# uv
.uv/

# Local evidence corpus
/evidence/
