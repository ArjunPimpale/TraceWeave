# PECS — .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables
.env
!.env.example

# Data directories — never commit runtime data
data/chromadb/
data/sqlite/
data/logs/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Streamlit
.streamlit/

# pytest
.pytest_cache/
.coverage
htmlcov/

# uv
.uv/
uv.lock

# User Defined
evidence/
